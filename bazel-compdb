#!/usr/bin/env python3
"""Generate compile_commands.json for a Bazel workspace, for clangd.

Uses `bazel aquery`, so it needs no changes to the workspace's MODULE.bazel
and does not depend on bazel-compile-commands-extractor, which is broken on
Bazel 9 (it calls native.py_binary, removed in that release).

The emitted "directory" is Bazel's execution root rather than the workspace
root. Bazel's compile actions use paths relative to the execution root
(external/googletest+/..., bazel-out/...), and those normally resolve via the
bazel-out / external convenience symlinks -- which a workspace that sets
--symlink_prefix=/ does not have. Pointing at the execution root directly
resolves them without putting build output back in the source tree.

Usage: bazel-compdb [target-pattern ...]    (default: //...)
"""
import json
import os
import subprocess
import sys

# Flags gcc accepts that make clang error out or warn noisily.
DROP_EXACT = {
    "-fno-canonical-system-headers",
    "-Wno-free-nonheap-object",
    "-Wunused-but-set-parameter",
}
SRC_SUFFIXES = (".cpp", ".cc", ".cxx", ".c", ".C", ".c++")


def bazel_info(workspace, key):
    return subprocess.run(
        ["bazel", "info", key], cwd=workspace, capture_output=True, text=True, check=True
    ).stdout.strip()


def main():
    patterns = sys.argv[1:] or ["//..."]
    workspace = bazel_info(os.getcwd(), "workspace")
    execroot = bazel_info(workspace, "execution_root")

    query = "mnemonic('CppCompile', %s)" % " + ".join(patterns)
    print("aquery: %s" % query, file=sys.stderr)
    proc = subprocess.run(
        ["bazel", "aquery", query, "--output=jsonproto", "--ui_event_filters=-info",
         "--noshow_progress"],
        cwd=workspace, capture_output=True, text=True,
    )
    if proc.returncode != 0:
        sys.exit("bazel aquery failed:\n%s" % proc.stderr)

    actions = json.loads(proc.stdout).get("actions", [])
    entries, seen = [], set()
    for action in actions:
        args = [a for a in action.get("arguments", []) if a not in DROP_EXACT]
        if not args:
            continue
        # The source is the argument following -c; fall back to a suffix scan.
        src = None
        if "-c" in args:
            idx = args.index("-c")
            if idx + 1 < len(args):
                src = args[idx + 1]
        if src is None or not src.endswith(SRC_SUFFIXES):
            cands = [a for a in args[1:] if a.endswith(SRC_SUFFIXES)]
            if not cands:
                continue
            src = cands[0]
        if src in seen:
            continue
        seen.add(src)
        # Main-repo sources live in the real source tree; point clangd there so
        # the entry matches the path of the buffer the user actually opens.
        # External sources exist only under the execution root.
        abs_src = os.path.join(workspace if not src.startswith("external/") else execroot, src)
        entries.append({"file": abs_src, "directory": execroot, "arguments": args})

    out = os.path.join(workspace, "compile_commands.json")
    with open(out, "w") as fh:
        json.dump(entries, fh, indent=2)
    print("wrote %d entries to %s" % (len(entries), out), file=sys.stderr)


if __name__ == "__main__":
    main()
